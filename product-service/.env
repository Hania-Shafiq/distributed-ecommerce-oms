# ── Product Service — Environment Variables ───────────────────
# These are loaded at startup by pydantic-settings (settings.py)
# and by python-dotenv. Never commit real credentials to git.

# PostgreSQL connection string for products_db
# Format: postgresql://<user>:<password>@<host>:<port>/<db_name>
# Port 5434 is mapped in docker-compose.yml → products_db container
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/products_db

# Elasticsearch base URL (single-node, no auth, security disabled in compose)
ELASTICSEARCH_URL=http://localhost:9200
