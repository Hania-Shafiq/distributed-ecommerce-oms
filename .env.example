# ─────────────────────────────────────────────────────────────────────────────
# Environment Configuration Template (.env.example)
# ─────────────────────────────────────────────────────────────────────────────
# Copy this template to .env and configure secret keys before running:
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ── JWT Authentication & Internal Service Mesh Key ───────────────────────────
# Generate cryptographically secure tokens via:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=your_jwt_signing_secret_min_32_chars
INTERNAL_SERVICE_KEY=your_internal_service_mesh_key_32_chars

# ── PostgreSQL Database Credentials ───────────────────────────────────────────
USERS_DB_USER=postgres
USERS_DB_PASSWORD=your_secure_users_db_password
USERS_DB_NAME=users_db

PRODUCTS_DB_USER=postgres
PRODUCTS_DB_PASSWORD=your_secure_products_db_password
PRODUCTS_DB_NAME=products_db

ORDERS_DB_USER=postgres
ORDERS_DB_PASSWORD=your_secure_orders_db_password
ORDERS_DB_NAME=orders_db

INVENTORY_DB_USER=postgres
INVENTORY_DB_PASSWORD=your_secure_inventory_db_password
INVENTORY_DB_NAME=inventory_db

# ── Neo4j Graph Database ──────────────────────────────────────────────────────
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_secure_neo4j_password

# ── CORS Allowed Origins ──────────────────────────────────────────────────────
# Comma-separated list of origins allowed by CORS in backend microservices
CORS_ORIGINS=http://localhost:5173,http://localhost:8000,http://127.0.0.1:5173,http://127.0.0.1:8000

# ── Frontend API Gateway Endpoint ─────────────────────────────────────────────
VITE_API_URL=http://localhost:8000

# ── Capacity & Concurrency Knobs ──────────────────────────────────────────────
DB_POOL_SIZE=25
DB_MAX_OVERFLOW=15
DB_POOL_TIMEOUT=30
UVICORN_LIMIT_CONCURRENCY=500
UVICORN_WORKERS=1
POSTGRES_MAX_CONNECTIONS=100

# ── Search Relevance & kNN Knobs ──────────────────────────────────────────────
SEARCH_KNN_K=50
SEARCH_KNN_CANDIDATES=100
SEARCH_MIN_SIMILARITY=0.54

